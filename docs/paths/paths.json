{
  "/auth/login": {
    "post": {
      "summary": "Login",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas.json#/LoginSchema"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Successful login",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas.json#/TokenResponse"
              }
            }
          }
        },
        "400": { "$ref": "../components/responses.json#/BadRequest" },
        "401": { "$ref": "../components/responses.json#/Unauthorized" }
      }
    }
  },
  "/auth/logout": {
    "delete": {
      "summary": "Logout",
      "security": [{ "BearerAuth": [] }],
      "responses": {
        "204": {
          "description": "Logout successful"
        },
        "401": { "$ref": "../components/responses.json#/Unauthorized" }
      }
    }
  },
  "/auth/refresh": {
    "post": {
      "summary": "Refresh access token",
      "security": [{ "BearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Token refreshed",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas.json#/TokenResponse"
              }
            }
          }
        },
        "401": { "$ref": "../components/responses.json#/Unauthorized" }
      }
    }
  },
  "/auth/recover": {
    "post": {
      "summary": "Send password recovery OTP",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas.json#/RecoverSchema"
            }
          }
        }
      },
      "responses": {
        "204": {
          "description": "OTP sent"
        },
        "400": { "$ref": "../components/responses.json#/BadRequest" },
        "404": { "$ref": "../components/responses.json#/NotFound" }
      }
    }
  },
  "/auth/verify-recovery": {
    "post": {
      "summary": "Verify recovery OTP and update password",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas.json#/VerifyRecoverySchema"
            }
          }
        }
      },
      "responses": {
        "204": {
          "description": "Password updated successfully"
        },
        "400": { "$ref": "../components/responses.json#/BadRequest" },
        "401": { "$ref": "../components/responses.json#/Unauthorized" },
        "404": { "$ref": "../components/responses.json#/NotFound" }
      }
    }
  },
  "/users/{id}": {
    "get": {
      "summary": "Get user by ID",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "User found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas.json#/UserResponse"
              }
            }
          }
        },
        "401": { "$ref": "../components/responses.json#/Unauthorized" },
        "404": { "$ref": "../components/responses.json#/NotFound" }
      }
    },
    "delete": {
      "summary": "Delete user by ID",
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "204": {
          "description": "User deleted"
        },
        "401": { "$ref": "../components/responses.json#/Unauthorized" },
        "403": { "$ref": "../components/responses.json#/Forbidden" },
        "404": { "$ref": "../components/responses.json#/NotFound" }
      }
    }
  },
  "/users/me": {
    "get": {
      "summary": "Get authenticated user's profile",
      "security": [{ "BearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Current user profile",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas.json#/UserResponse"
              }
            }
          }
        },
        "401": { "$ref": "../components/responses.json#/Unauthorized" }
      }
    },
    "patch": {
      "summary": "Update authenticated user's password",
      "security": [{ "BearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas.json#/UpdateUserSchema"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "User updated",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas.json#/UserResponse"
              }
            }
          }
        },
        "400": { "$ref": "../components/responses.json#/BadRequest" },
        "401": { "$ref": "../components/responses.json#/Unauthorized" }
      }
    }
  },
  "/users": {
    "post": {
      "summary": "Create a new user",
      "security": [{ "BearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas.json#/CreateUserSchema"
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "User created",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas.json#/UserResponse"
              }
            }
          }
        },
        "400": { "$ref": "../components/responses.json#/BadRequest" },
        "401": { "$ref": "../components/responses.json#/Unauthorized" },
        "403": { "$ref": "../components/responses.json#/Forbidden" },
        "409": { "$ref": "../components/responses.json#/Conflict" }
      }
    }
  },
  "/users/{id}/admin": {
    "patch": {
      "summary": "Admin update user",
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas.json#/AdminUpdateUserSchema"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "User updated by admin",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas.json#/UserResponse"
              }
            }
          }
        },
        "400": { "$ref": "../components/responses.json#/BadRequest" },
        "401": { "$ref": "../components/responses.json#/Unauthorized" },
        "403": { "$ref": "../components/responses.json#/Forbidden" },
        "404": { "$ref": "../components/responses.json#/NotFound" },
        "409": { "$ref": "../components/responses.json#/Conflict" }
      }
    }
  }
}
